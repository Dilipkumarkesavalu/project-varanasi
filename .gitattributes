# Normalise line endings so Windows and Linux (CI, Docker) see identical files.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.woff2 binary

