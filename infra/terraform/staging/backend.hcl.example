# Copy to backend.hcl (git-ignored values are fine to commit here; no secrets).
# Create the state bucket once, by hand or with a bootstrap stack, with versioning on.
bucket       = "varanasi-terraform-state-<aws-account-id>"
key          = "staging/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
