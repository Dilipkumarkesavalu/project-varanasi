# Copy to .env for local development:  cp .env.example .env
# Every variable the backend reads (ADR-0008 §10). .env is git-ignored; never commit real secrets.
# The values below are LOCAL-ONLY development values, not production credentials.
# Secrets may also be given as files: VARANASI_<NAME>_FILE=/run/secrets/<name>

# --- General --------------------------------------------------------------
# local | test | staging | production
VARANASI_ENV=local
VARANASI_LOG_LEVEL=INFO
# json on servers, console locally
VARANASI_LOG_FORMAT=console

# --- Host ports for docker compose (defaults avoid clashing with other projects) ---
VARANASI_PG_HOST_PORT=55432
VARANASI_REDIS_HOST_PORT=56379
VARANASI_STORAGE_HOST_PORT=59000
VARANASI_STORAGE_CONSOLE_HOST_PORT=59001
VARANASI_API_HOST_PORT=8000

# --- PostgreSQL (docker compose service "postgres") -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=varanasi
VARANASI_DB_MIGRATOR_PASSWORD=local-dev-only-migrator
VARANASI_DB_PLATFORM_PASSWORD=local-dev-only-platform
VARANASI_DB_BILLING_PASSWORD=local-dev-only-billing
VARANASI_DB_HRMS_PASSWORD=local-dev-only-hrms
# One runtime role per module (ADR-0003); the migrator only runs Alembic.
VARANASI_DB_MIGRATOR_URL=postgresql://varanasi_migrator:local-dev-only-migrator@localhost:55432/varanasi
VARANASI_DB_PLATFORM_URL=postgresql://varanasi_platform_app:local-dev-only-platform@localhost:55432/varanasi
VARANASI_DB_BILLING_URL=postgresql://varanasi_billing_app:local-dev-only-billing@localhost:55432/varanasi
VARANASI_DB_HRMS_URL=postgresql://varanasi_hrms_app:local-dev-only-hrms@localhost:55432/varanasi

# --- Redis (cache only; events use RabbitMQ, ADR-0005) -------------------------
VARANASI_REDIS_URL=redis://localhost:56379/0

# --- Object storage: RustFS locally, S3 in AWS (ADR-0012) -----------------------
VARANASI_STORAGE_BUCKET=varanasi-local
# leave unset in AWS
VARANASI_STORAGE_ENDPOINT_URL=http://localhost:59000
VARANASI_STORAGE_REGION=ap-south-1
# unset in AWS: the instance role is used
VARANASI_STORAGE_ACCESS_KEY_ID=local-dev-only
VARANASI_STORAGE_SECRET_ACCESS_KEY=local-dev-only-secret
# local only
VARANASI_STORAGE_CREATE_BUCKET=true

# --- HTTP ----------------------------------------------------------------
# Comma-separated. The Flutter dev servers (apps/*) run on these ports.
VARANASI_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083
